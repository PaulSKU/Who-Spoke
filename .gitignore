# Secrets
.env

# Données non versionnées (D13)
data/raw/
data/processed/

# Audio
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus

# Caches de modèles
.cache/
hf_cache/
pretrained_models/
*.ckpt
*.nemo

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Système
.DS_Store

# Traces des moteurs (D19 §3)
experiments/*/trace/

# Environnements séparés des moteurs externes (D23 §1, E4) ; recréés par scripts/envs/
/envs/

# Contrôle visuel (tests/visuel, outils Node de développement)
tests/visuel/node_modules/
tests/visuel/test-results/
tests/visuel/playwright-report/
tests/visuel/.donnees/
tests/visuel/defauts/
tests/visuel/b11/
tests/visuel/b12/
tests/visuel/b13/

# Corpus maison : aucune sortie par segment versionnée tant que les consentements ne sont pas
# recueillis (conventions d'annotation, emplacement des références ; prompt A9 du 05/11).
# Hypothèses des expériences maison (rttm/, rttm_<sortie>/) gardées en local.
experiments/*maison*/rttm/
experiments/*maison*/rttm_*/
